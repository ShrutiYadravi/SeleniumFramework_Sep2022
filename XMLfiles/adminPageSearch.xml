<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AdminSearchSuite">

    <!-- Listener for Extent Reports -->
    <listeners>
        <listener class-name="listeners.ExtentTestNGITestListener"/>
    </listeners>

    <!-- Admin Search Test -->
    <test name="AdminSearchTest" thread-count="1">
        <classes>
            <class name="testcases.AdminSearchTest">
                <methods>
                    <include name="verifyAdminPageSearch"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
