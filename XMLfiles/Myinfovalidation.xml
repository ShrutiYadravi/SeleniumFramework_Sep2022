<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="MyInfoValidationSuite">

    <!-- Optional: Listener for Extent Reports -->
    <listeners>
        <listener class-name="listeners.ExtentTestNGITestListener"/>
    </listeners>

    <test name="MyInfoValidationTest" thread-count="1">
        <classes>
            <class name="testcases.MyInfoValidation">
                <methods>
                    <include name="validateMyInfoDetails"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
